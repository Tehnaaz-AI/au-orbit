# AUOrbit Backend Environment Configuration

# Database Configuration
# Local SQLite default: sqlite:///./auorbit.db
# PostgreSQL / Supabase: postgresql+psycopg://postgres:<PASSWORD>@<HOST>:5432/<DATABASE>
DATABASE_URL=sqlite:///./auorbit.db

# Authentication & Security
# WARNING: Generate a secure 64-character hex key for production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Integration: Twilio / WhatsApp Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
DEMO_WHATSAPP_TO=
TWILIO_CONTENT_SID=

# Optional Integration: External n8n Webhook Relay
N8N_WEBHOOK_URL=http://localhost:5678/webhook/auorbit-alert
