# =====================================================================
# AUOrbit Platform Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Local SQLite Default: sqlite:///./auorbit.db
# PostgreSQL / Supabase: postgresql+psycopg://postgres:<PASSWORD>@<HOST>:5432/<DATABASE>
DATABASE_URL=sqlite:///./auorbit.db

# ---------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (UNDERSTANDING & TRIAGE AGENT)
# ---------------------------------------------------------------------
# Used by UnderstandingAgent for multimodal problem extraction & NLP triage.
# If left blank, AUOrbit automatically falls back to deterministic rule-based parsing.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ---------------------------------------------------------------------
# Secret key for signing user sessions. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=auorbit-dev-secret-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# 4. CORS & NETWORKING
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
ENV=development

# ---------------------------------------------------------------------
# 5. OPTIONAL: TWILIO / WHATSAPP DISPATCH ALERTS
# ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
DEMO_WHATSAPP_TO=
TWILIO_CONTENT_SID=

# ---------------------------------------------------------------------
# 6. OPTIONAL: N8N AUTOMATION WEBHOOK
# ---------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/auorbit-alert
